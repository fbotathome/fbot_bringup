<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fbot_bringup</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="jfsslemos@gmail.com">jota</maintainer>
  <license>TODO: License declaration</license>

  <!-- robot body (robot.launch.py and the launches it includes).
       Also needed at runtime ON THE ROBOT but intentionally not declared here, so
       bringup still builds on a laptop without the hardware stack:
       fbot_head (neck_controller) and hoverboard_driver (ros2_control plugin). -->
  <exec_depend>fbot_description</exec_depend>
  <exec_depend>fbot_navigation</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>urg_node</exec_depend>
  <exec_depend>bno055</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>sick_scan_xd</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
